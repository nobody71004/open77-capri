# Copy to .env and edit. Never commit .env.
# These values are read by the install/verify scripts.

OPEN77_ROOT=/opt/open77-xbuniverse
OPEN77_SERVICE=open77-xbuniverse.service

# Optional staging target
OPEN77_STAGING_ROOT=/opt/open77-xbuniverse-staging
OPEN77_STAGING_SERVICE=open77-xbuniverse-staging.service

# Optional client brain. Do not put API keys in this file.
CAPRI_VOZ_URL=http://localhost:4325
CAPRI_OMNIVOICE_URL=http://127.0.0.1:8880
CAPRI_BRAIN_BACKEND=ollama
CAPRI_BRAIN_MODEL=llama3.2:3b
# OPENAI_API_KEY is deliberately absent. Put your own key in a local,
# untracked file if you choose the Freebuff/OpenAI-compatible backend.
