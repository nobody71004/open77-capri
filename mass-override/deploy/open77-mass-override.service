[Unit]
Description=Open77 Mass Override feed (production)
After=network.target

[Service]
WorkingDirectory=/opt/open77-mass-override
ExecStart=/usr/bin/node /opt/open77-mass-override/dev-server.js
Environment=MASS_OVERRIDE_PORT=11901
Restart=on-failure
User=root

[Install]
WantedBy=multi-user.target
