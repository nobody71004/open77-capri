@echo off
setlocal EnableExtensions
title Capri thinks with the server's brain on XyberRP Staging
rem ---------------------------------------------------------------------------------------------
rem   Why Capri said "I'm here, V, but disconnected": the Capri package the Open77 launcher gives
rem   players never said where the brain on the game servers' machine is (the launcher may not ship
rem   her settings.json), so every PC but one set up by hand started her on Player2, her default.
rem   This puts Capri.ServerBrain.reds into Staging's Capri package: at the game's start every
rem   player's Capri thinks with the server's brain.  A player's own service with its own key stays.
rem   LEAVE STAGING FIRST: the change refuses while anybody is on it.
rem   1. READ ONLY: Staging's Capri package as it is now and the brain's address, from the machine;
rem      the brain asked from this PC, the way a player's game asks it.
rem   2. The new package -- the live one plus that one script, and Capri's 12 scripts that REDscript
rem      rewrote at EVERY start (its "REDscript migration" window) already migrated, the way your
rem      game migrated them -- checked with YOUR GAME'S OWN Redscript
rem      compiler on this PC -- the live package first, then the new one.  Nothing is sent unless it
rem      compiles.  Then it goes into Staging's mod store and server.jsonc names it (kept first).
rem   3. The brain's nginx location gets per-address limits (once for the machine; nothing when
rem      they are there): its private address now travels to every player who joins.
rem   4. Staging restarted: players get the new Capri from the launcher when they join.
rem   5. READ ONLY: what Staging hands out now, checked end to end.
rem   Nothing else changes: XyberRP, the brain, nginx and the other mods stay as they are.
rem   Logs: kit\capri-*.log here, and ..\open77-av-kit\avkit-restart-*.log.
rem ---------------------------------------------------------------------------------------------
set "PY=%LOCALAPPDATA%\Programs\fivem2open77\runtime\python\python.exe"
if not exist "%PY%" goto nopython
set "CK=%~dp0kit\capri_kit.py"
if not exist "%CK%" goto nokit
set "AVK="
if exist "%~dp0..\open77-av-kit\av_kit.py" set "AVK=%~dp0..\open77-av-kit"
if not defined AVK if exist "%USERPROFILE%\Downloads\open77-av-kit\av_kit.py" set "AVK=%USERPROFILE%\Downloads\open77-av-kit"
if not defined AVK goto noavkit
set "AV=%AVK%\av_kit.py"
set "O77_AV_KIT=%AVK%"
@@HOST@@

echo.
echo Next: Capri thinks with the server's brain for every player on XyberRP Staging.  Leave
echo Staging first (quit to the menu): the change refuses while anybody is on it.
choice /C YN /M "Capri thinks with the server's brain on Staging now"
if errorlevel 2 goto declined
echo.
set "RG=0"
echo === 1-2. The new Capri for Staging: built, checked with your game's Redscript, put on Staging
"%PY%" -X utf8 "%CK%" publish --role staging %HOST%
set "RC=%ERRORLEVEL%"
if "%RC%"=="5" goto already
if not "%RC%"=="0" goto notpublished
call :guard
echo.
echo === 4. Staging restarted: players get the new Capri when they join
"%PY%" -X utf8 "%AV%" restart --on open77-xbuniverse-staging %HOST%
set "RS=%ERRORLEVEL%"
if not "%RS%"=="0" goto notrestarted
:verify
echo.
echo === 5. READ ONLY: what Staging hands out now
"%PY%" -X utf8 "%CK%" verify --role staging %HOST%
set "RV=%ERRORLEVEL%"
if not "%RV%"=="0" goto notverified
if not "%RG%"=="0" echo (Step 3 did NOT add the brain's per-address limits: see its lines above.)
echo.
echo Done.  Now, on the PC you play on (the desktop too):
echo   1. join XyberRP Staging through the Open77 launcher: it names Capri and asks once before
echo      installing her new build (it carries a DLL) -- accept;
echo      No "REDscript migration" window should come up as the game starts any more;
echo   2. load in and wait a few seconds: she should say "Here I am, V" and NOT "disconnected";
echo   3. talk to her (Enter, or hold CapsLock): her first answer takes up to half a minute -- the
echo      brain thinks on the server's processors;
echo   4. then run C1 here: it shows what the brain was asked from your games.
echo Then tell Claude how she did.  If she is fine, C3 does the same for live XyberRP.
pause
exit /b 0

:already
echo.
echo Staging's Capri already thinks with the server's brain at this address: nothing changed.
call :guard
goto verify

:guard
echo.
echo === 3. The brain's per-address limits (its private address now goes to every player)
"%PY%" -X utf8 "%CK%" guard %HOST%
set "RG=%ERRORLEVEL%"
exit /b 0

:declined
echo.
echo Nothing done, nothing changed.
pause
exit /b 0

:notpublished
echo.
echo Staging's Capri was NOT changed (exit %RC%): see the lines above, and tell Claude "done".
echo (exit 3: somebody is on Staging -- you too count -- or its Capri changed meanwhile: leave
echo it and run this again.  exit 2: this PC could not check the package with your game's
echo Redscript -- the lines above say why.  exit 1: something else; nothing was sent.)
pause
exit /b %RC%

:notrestarted
echo.
echo Staging's server.jsonc names the new Capri, but Staging did not restart (exit %RS%).  exit 3:
echo somebody joined meanwhile -- leave it and run this again (the change is in, the restart is
echo what is missing).  exit 4: the Open77 master server refused the start for now: Staging is
echo stopped, run this again in a few minutes.  Tell Claude "done".
pause
exit /b %RS%

:notverified
echo.
echo Staging restarted, but what it hands out is not checked yet (exit %RV%): see the lines above
echo and tell Claude "done".  C2b puts Staging's Capri back.
pause
exit /b %RV%

:nopython
echo FAILED: fivem2open77 Studio's Python is not at %PY% - is the Studio installed?
pause
exit /b 1

:nokit
echo FAILED: this folder's own kit (kit\capri_kit.py) is missing: unpack the whole folder again.
pause
exit /b 1

:noavkit
echo FAILED: the AV kit's av_kit.py was not found: not in %~dp0..\open77-av-kit, not in
echo %USERPROFILE%\Downloads\open77-av-kit.  It signs in to the machine the way the Studio does.
pause
exit /b 1
